# Production PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a long random secret (at least 32 bytes)
AUTH_SECRET=replace-with-a-long-random-secret

# Temporary Netlify URL or your future custom domain
NEXT_PUBLIC_SITE_URL=https://ganvesys-technologies.netlify.app

# Initial admin seed credentials — change before first production use
ADMIN_EMAIL=admin@ganvesystechnologies.com
ADMIN_PASSWORD=change-this-before-production
